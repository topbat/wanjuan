  "notes": "篇名、作者、分组与顺序均依教育部官网发布的课标 PDF（教材〔2020〕3号附件）附录1原文转录：1～32 为文言文（必修10、选择性必修10、选修12，其中“古代文论选段”为选修1条），33～72 为诗词曲40首。朝代为公认事实标注。",
  "items": [
    { "no": 1, "title": "《论语》十二章", "author": "《论语》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "必修。所选十二章：人而不仁；朝闻道；君子喻于义；见贤思齐焉；质胜文则野；士不可以不弘毅；譬如为山；知者不惑；有一言而可以终身行之者乎；小子何莫学夫《诗》；君子食无求饱；克己复礼为仁" },
    { "no": 2, "title": "劝学", "author": "《荀子》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "必修。节选：学不可以已……用心躁也" },
    { "no": 3, "title": "屈原列传", "author": "司马迁", "dynasty": "汉", "form": "文言文", "grade": null, "recitation": true, "note": "必修。节选：屈平疾王听之不聪也……虽与日月争光可也" },
    { "no": 4, "title": "谏太宗十思疏", "author": "魏征", "dynasty": "唐", "form": "文言文", "grade": null, "recitation": true, "note": "必修" },
