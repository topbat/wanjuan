    { "no": 19, "title": "石钟山记", "author": "苏轼", "dynasty": "宋", "form": "文言文", "grade": null, "recitation": true, "note": "选择性必修" },
    { "no": 20, "title": "登泰山记", "author": "姚鼐", "dynasty": "清", "form": "文言文", "grade": null, "recitation": true, "note": "选择性必修" },
    { "no": 21, "title": "《老子》八章", "author": "《老子》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "选修。所选八章：第八章“上善若水”；第十二章“五色令人目盲”；第十五章“古之善为士者”；第二十二章“曲则全”；第二十四章“跂者不立”；第二十七章“善行无辙迹”；第三十三章“知人者智”；第八十一章“信言不美”" },
    { "no": 22, "title": "季氏将伐颛臾", "author": "《论语》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "选修" },
    { "no": 23, "title": "大学", "author": "《礼记》", "dynasty": "汉", "form": "文言文", "grade": null, "recitation": true, "note": "选修。节选：古之欲明明德于天下者……壹是皆以修身为本" },
    { "no": 24, "title": "中庸", "author": "《礼记》", "dynasty": "汉", "form": "文言文", "grade": null, "recitation": true, "note": "选修。节选：喜怒哀乐之未发……万物育焉；博学之……人十能之，己千之" },
    { "no": 25, "title": "《孟子》一则", "author": "《孟子》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "选修。节选：敢问夫子恶乎长……则不能也" },
    { "no": 26, "title": "逍遥游", "author": "《庄子》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "选修。节选：惠子谓庄子曰……则夫子犹有蓬之心也夫" },
    { "no": 27, "title": "谏逐客书", "author": "李斯", "dynasty": "秦", "form": "文言文", "grade": null, "recitation": true, "note": "选修" },
