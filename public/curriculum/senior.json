    { "no": 30, "title": "黄冈竹楼记", "author": "王禹偁", "dynasty": "宋", "form": "文言文", "grade": null, "recitation": true, "note": "选修" },
    { "no": 31, "title": "上枢密韩太尉书", "author": "苏辙", "dynasty": "宋", "form": "文言文", "grade": null, "recitation": true, "note": "选修" },
    { "no": 32, "title": "古代文论选段", "author": null, "dynasty": null, "form": "文言文", "grade": null, "recitation": true, "note": "选修。含六则：毛诗序（诗者，志之所之也……不知手之舞之足之蹈之也），汉；典论·论文（盖文章，经国之大业……而声名自传于后），曹丕，三国；诗品序（若乃春风春鸟……故曰“《诗》可以群，可以怨”），锺嵘，南北朝；与元九书（感人心者……华声，实义），白居易，唐；题画（江馆清秋……独画云乎哉），郑燮，清；人间词话（词以境界为最上……恐为晏欧诸公所不许也），王国维，近现代" },
    { "no": 33, "title": "静女", "author": "《诗经·邶风》", "dynasty": "先秦", "form": "四言诗", "grade": null, "recitation": true, "note": "诗词曲40首之1" },
    { "no": 34, "title": "无衣", "author": "《诗经·秦风》", "dynasty": "先秦", "form": "四言诗", "grade": null, "recitation": true, "note": "诗词曲40首之2" },
