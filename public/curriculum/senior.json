    { "no": 8, "title": "答司马谏议书", "author": "王安石", "dynasty": "宋", "form": "文言文", "grade": null, "recitation": true, "note": "必修" },
    { "no": 9, "title": "赤壁赋", "author": "苏轼", "dynasty": "宋", "form": "文言文（赋）", "grade": null, "recitation": true, "note": "必修" },
    { "no": 10, "title": "项脊轩志", "author": "归有光", "dynasty": "明", "form": "文言文", "grade": null, "recitation": true, "note": "必修" },
    { "no": 11, "title": "子路、曾晳、冉有、公西华侍坐", "author": "《论语》", "dynasty": "先秦", "form": "文言文", "grade": null, "recitation": true, "note": "选择性必修" },
    { "no": 12, "title": "报任安书", "author": "司马迁", "dynasty": "汉", "form": "文言文", "grade": null, "recitation": true, "note": "选择性必修。节选：古者富贵而名摩灭……难为俗人言也" },
    { "no": 13, "title": "过秦论（上）", "author": "贾谊", "dynasty": "汉", "form": "文言文", "grade": null, "recitation": true, "note": "选择性必修" },
    { "no": 14, "title": "礼运", "author": "《礼记》", "dynasty": "汉", "form": "文言文", "grade": null, "recitation": true, "note": "选择性必修。节选：大道之行也……是谓大同" },
